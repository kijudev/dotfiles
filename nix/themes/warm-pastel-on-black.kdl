theme {
  # Base Colors
  fg "#E0E0E0" # Soft Off-White Foreground
  bg "#000000" # Pure Black Background

  # ANSI Standard Colors (Warm Pastels)
  black "#2C2C2C" # Dark Gray
  red "#FF9AA2" # Soft Rose Red
  green "#B5EAD7" # Gentle Mint Green
  yellow "#FFD1AA" # Light Peach Yellow
  blue "#A6DCEF" # Sky Blue
  magenta "#E0BBE4" # Lavender Purple
  cyan "#A8E6CF" # Pale Turquoise
  white "#E0E0E0" # Soft Off-White

  # Bright/Bold Colors
  orange "#FFC48C" # Highlights
  bright-black "#555555"
  bright-red "#FF6B82"
  bright-green "#80DAA8"
  bright-yellow "#FFBD6F"
  bright-blue "#83C5E7"
  bright-magenta "#D19DEB"
  bright-cyan "#70D5B4"
  bright-white "#FFFFFF" # Pure White
}
